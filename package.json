{
  "name": "carapace-m365",
  "description": "🐚📧📅✅📁 Microsoft 365 tools for Outlook mail, calendars, Microsoft To Do, and OneDrive through Microsoft Graph.",
  "version": "1.5.1",
  "type": "module",
  "main": "dist/plugin.js",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "bin": {
    "carapace-m365": "./dist/bin/m365.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "assets/icon.png",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build:auth && npm run build:plugin && npm run build:webhook",
    "build:auth": "npm run build --workspace @carapace/m365-graph-auth",
    "build:plugin": "tsup && npm run generate:plugin && npm run check:manifest",
    "generate:plugin": "carapace-generate-cli --entry ./dist/plugin.js --out ./dist/bin",
    "check:manifest": "node -e \"require('node:assert/strict').strictEqual(require('./openclaw.plugin.json').version, require('./package.json').version)\"",
    "build:webhook": "npm run build --workspace @carapace/m365-webhook",
    "login": "node scripts/login.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p services/m365-webhook/tsconfig.json",
    "deploy": "node scripts/deploy.mjs",
    "prepack": "npm run --silent check:manifest && node scripts/prepare-package.mjs",
    "postpack": "node scripts/prepare-package.mjs --restore"
  },
  "devDependencies": {
    "@carapace/m365-graph-auth": "1.0.0",
    "@carapace/m365-mail-store": "*",
    "@types/node": "^26.6.2",
    "tsup": "^8.3.0",
    "typescript": "^7",
    "vitest": "^4.1.10",
    "@sinclair/typebox": "^0.34.52"
  },
  "openclaw": {
    "extensions": [
      "./dist/adapter.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.10"
    },
    "build": {
      "openclawVersion": "2026.11.10"
    }
  },
  "peerDependencies": {
    "openclaw": "^2026.4.23"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "carapace-plugin-sdk": "^3.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffSteinbok/carapace-m365.git"
  }
}
